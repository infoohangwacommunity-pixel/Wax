# ===========================================================================
# WAX environment configuration template.
# Copy to `.env` and fill in real values. NEVER commit real `.env` files.
# ===========================================================================

# --- Runtime ---
WAX_ENV=development
# One of: development, staging, production

WAX_LOG_LEVEL=INFO
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL

WAX_LOG_FORMAT=console
# One of: console (human-readable), json (machine-readable)

# --- HTTP ---
WAX_HOST=127.0.0.1
WAX_PORT=8000

# --- Database ---
# Examples:
#   SQLite (local dev / tests):  sqlite+aiosqlite:///./wax.db
#   PostgreSQL (production):     postgresql+asyncpg://user:pass@host:5432/wax
WAX_DATABASE_URL=sqlite+aiosqlite:///./wax.db

# --- Secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
WAX_SECRET_KEY=change-me-to-a-real-secret

# --- Control plane (ADR-0048) ---
# Shared operator token for the server-rendered dashboard at /control.
# REQUIRED in production (the dashboard refuses to serve without it);
# optional in development (an open dashboard shows a loud banner).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WAX_CONTROL_PLANE_TOKEN=

# --- Workspace persistence (P0-Workspace) ---
# Root of the content-addressed blob store. workspace.snapshot writes
# file bytes here (keyed by sha256) so workspace.restore works even after
# the source workspace has been released and deleted.
WAX_SNAPSHOT_BLOB_ROOT=./wax-blobs

# --- LLM providers (Phase O — Intelligence) ---
# Leave empty until Phase O is reached.
WAX_LLM_DEFAULT_PROVIDER=
WAX_OPENAI_API_KEY=
WAX_ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Phase Q — Interface) ---
# Get these from Meta Developer dashboard:
# https://developers.facebook.com/apps/ → your app → WhatsApp → API Setup
WAX_WHATSAPP_ACCESS_TOKEN=
WAX_WHATSAPP_PHONE_NUMBER_ID=
WAX_WHATSAPP_APP_SECRET=
# Verify token is a string you set; Meta echoes it during webhook setup
WAX_WHATSAPP_VERIFY_TOKEN=wax-default-verify-token
